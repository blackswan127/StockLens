# -----------------------------------------------------------------------------
# StockLens environment variables
# Copy this file to .env and fill in only the values you need.
# -----------------------------------------------------------------------------

# HTTP port the Express server listens on (default: 3000).
PORT=

# Runtime mode: "development" or "production" (default: development).
NODE_ENV=

# Pino log level: trace, debug, info, warn, error, fatal (default: info).
LOG_LEVEL=

# Path to the SQLite database file (default: ./stocklens.db).
SQLITE_DB_PATH=

# Public URL of the frontend. Required in production for CORS allow-listing.
CLIENT_URL=

# Set to "true" to fork one worker per CPU in production.
CLUSTER=

# FRED API key for macroeconomic data (https://fred.stlouisfed.org/docs/api/api_key.html).
FRED_API_KEY=

# Alpha Vantage key used as a fallback when Yahoo Finance is unavailable.
# Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Legacy alias for ALPHAVANTAGE_API_KEY.
ALPHA_VANTAGE_API_KEY=

# Gemini API key for AI-powered features.
GEMINI_API_KEY=

# Optional list of Gemini keys separated by commas, semicolons, or newlines.
# Takes precedence over GEMINI_API_KEY.
GEMINI_API_KEYS=

# Redis connection string. Enables shared caching and rate-limit storage.
REDIS_URL=

# Optional shared secret for watchlist writes. When set, POST and DELETE
# /api/watchlist requests must send either "Authorization: Bearer <token>" or
# "X-Watchlist-Token: <token>". Leave empty to allow unauthenticated writes.
WATCHLIST_TOKEN=

# Build/dev tooling only: set to "true" to open the Vite bundle analyzer.
ANALYZE=

# Build/dev tooling only: set to "true" to disable Vite HMR and file watching.
DISABLE_HMR=
